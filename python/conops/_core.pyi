class CoreNetwork:
    """Rust TCP network with fixed-neighbor mDNS discovery and synchronous Exchange."""

    def __init__(
        self,
        node_id: str,
        port: int,
        neighbors: list[str] | None = None,
        group_id: str = "default",
    ) -> None: ...
    def start(self) -> None: ...
    def connect(self, peer_id: str, address: str) -> None: ...
    def peers(self) -> list[str]: ...
    def wait_connected(self, timeout: float | None = None) -> None: ...
    def exchange(
        self,
        exchange_id: int,
        data: bytes,
        timeout: float | None = None,
    ) -> dict[str, bytes]: ...
    def close(self) -> None: ...
